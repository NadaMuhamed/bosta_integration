<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bosta_integration_config_list" model="ir.ui.view">
        <field name="name">bosta.integration.config.list</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <list string="Bosta Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="integration_enabled"/>
                <field name="dashboard_password_configured"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bosta_integration_config_form" model="ir.ui.view">
        <field name="name">bosta.integration.config.form</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <form string="Bosta Integration Configuration">
                <header>
                    <button
                        name="action_clear_saved_password"
                        type="object"
                        string="Clear Saved Password"
                        class="btn-secondary"
                        groups="bosta_integration.group_bosta_integration_manager"
                        confirm="Clear the saved Bosta Dashboard password and disable the integration?"
                        invisible="not dashboard_password_configured"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group string="General">
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="integration_enabled"/>
                        </group>
                    </group>

                    <group string="Bosta Dashboard Credentials">
                        <group>
                            <field name="dashboard_url" placeholder="https://business.bosta.co/orders"/>
                            <field name="dashboard_login"/>
                            <field
                                name="dashboard_password_input"
                                password="True"
                                placeholder="Enter a new password"
                            />
                        </group>
                        <group>
                            <field name="dashboard_password_configured" readonly="1"/>
                            <field name="credentials_updated_at" readonly="1"/>
                            <field name="credentials_updated_by" readonly="1"/>
                        </group>
                    </group>

                    <div class="text-muted">
                        The password input is encrypted with a server-provided key and is empty whenever this form is reopened.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bosta_integration_config_search" model="ir.ui.view">
        <field name="name">bosta.integration.config.search</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <search string="Bosta Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="enabled" string="Enabled" domain="[('integration_enabled', '=', True)]"/>
                <filter name="password_configured" string="Password Configured" domain="[('dashboard_password_configured', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_bosta_integration_config" model="ir.actions.act_window">
        <field name="name">Bosta Configuration</field>
        <field name="res_model">bosta.integration.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bosta_integration_config_search"/>
    </record>

    <menuitem
        id="menu_bosta_integration_root"
        name="Bosta Integration"
        sequence="30"
        groups="bosta_integration.group_bosta_integration_manager"
    />

    <menuitem
        id="menu_bosta_integration_configuration"
        name="Configuration"
        parent="menu_bosta_integration_root"
        action="action_bosta_integration_config"
        sequence="10"
        groups="bosta_integration.group_bosta_integration_manager"
    />
</odoo>
