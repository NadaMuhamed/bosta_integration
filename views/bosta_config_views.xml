<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bosta_integration_config_list" model="ir.ui.view">
        <field name="name">bosta.integration.config.list</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <list string="Bosta Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="integration_enabled"/>
                <field name="api_key_configured"/>
                <field name="api_status"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bosta_integration_config_form" model="ir.ui.view">
        <field name="name">bosta.integration.config.form</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <form string="Bosta Integration Configuration">
                <header>
                    <button
                        name="action_test_api_connection"
                        type="object"
                        string="Test API Connection"
                        class="btn-primary"
                        groups="bosta_integration.group_bosta_integration_manager"
                    />
                    <button
                        name="action_sync_bosta_deliveries"
                        type="object"
                        string="Sync Bosta Deliveries"
                        groups="bosta_integration.group_bosta_integration_manager"
                        invisible="not integration_enabled"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <group string="General">
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="integration_enabled"/>
                        </group>
                    </group>

                    <group string="Bosta API">
                        <group>
                            <field name="api_base_url" placeholder="https://app.bosta.co"/>
                            <field name="api_key_env_var" placeholder="BOSTA_API_KEY"/>
                            <field name="api_key_configured" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_timeout_seconds"/>
                            <field name="page_size"/>
                            <field name="max_pages"/>
                        </group>
                    </group>

                    <group string="API Status">
                        <group>
                            <field name="api_status" readonly="1"/>
                            <field name="last_api_test_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_successful_api_request_at" readonly="1"/>
                            <field name="last_api_error" readonly="1"/>
                        </group>
                    </group>

                    <group string="Delivery Sync Status">
                        <group>
                            <field name="last_sync_status" readonly="1"/>
                            <field name="last_sync_started_at" readonly="1"/>
                            <field name="last_sync_completed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync_seen_count" readonly="1"/>
                            <field name="last_sync_created_count" readonly="1"/>
                            <field name="last_sync_updated_count" readonly="1"/>
                            <field name="last_sync_unchanged_count" readonly="1"/>
                            <field name="last_sync_conflict_count" readonly="1"/>
                            <field name="last_sync_error_count" readonly="1"/>
                            <field name="last_sync_error" readonly="1"/>
                        </group>
                    </group>

                    <div class="text-muted">
                        The API key is read from the server environment and is never stored in Odoo.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bosta_integration_config_search" model="ir.ui.view">
        <field name="name">bosta.integration.config.search</field>
        <field name="model">bosta.integration.config</field>
        <field name="groups_id" eval="[(4, ref('bosta_integration.group_bosta_integration_manager'))]"/>
        <field name="arch" type="xml">
            <search string="Bosta Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="enabled" string="Enabled" domain="[('integration_enabled', '=', True)]"/>
                <filter name="api_connected" string="API Connected" domain="[('api_status', '=', 'connected')]"/>
                <filter name="api_not_configured" string="API Not Configured" domain="[('api_status', '=', 'not_configured')]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_bosta_integration_config" model="ir.actions.act_window">
        <field name="name">Bosta Configuration</field>
        <field name="res_model">bosta.integration.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bosta_integration_config_search"/>
    </record>

    <menuitem
        id="menu_bosta_integration_root"
        name="Bosta Integration"
        sequence="30"
        groups="bosta_integration.group_bosta_integration_user"
    />

    <menuitem
        id="menu_bosta_integration_configuration"
        name="Configuration"
        parent="menu_bosta_integration_root"
        action="action_bosta_integration_config"
        sequence="10"
        groups="bosta_integration.group_bosta_integration_manager"
    />
</odoo>
