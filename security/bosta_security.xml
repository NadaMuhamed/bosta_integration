<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_bosta_integration_dashboard" model="ir.module.category">
            <field name="name">Bosta Integration</field>
            <field name="description">Access rights for the independent Bosta integration module.</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_bosta_integration_user" model="res.groups">
            <field name="name">Bosta Integration User</field>
            <field name="category_id" ref="bosta_integration.module_category_bosta_integration_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_bosta_integration_manager" model="res.groups">
            <field name="name">Bosta Integration Manager</field>
            <field name="category_id" ref="bosta_integration.module_category_bosta_integration_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('bosta_integration.group_bosta_integration_user'))]"/>
        </record>
    </data>
</odoo>
